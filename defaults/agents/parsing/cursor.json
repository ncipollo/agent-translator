[
  {
    "name": "system-init",
    "when": [
      {
        "op": "eq",
        "path": "type",
        "value": "system"
      },
      {
        "op": "eq",
        "path": "subtype",
        "value": "init"
      }
    ],
    "emit": {
      "event": "system_init",
      "fields": {
        "session_id": {
          "path": "session_id"
        },
        "model": {
          "path": "model"
        },
        "cwd": {
          "path": "cwd"
        }
      }
    }
  },
  {
    "name": "assistant-text",
    "when": [
      {
        "op": "eq",
        "path": "type",
        "value": "assistant"
      }
    ],
    "iterate": "message.content",
    "when_each": [
      {
        "op": "eq",
        "path": "type",
        "value": "text"
      }
    ],
    "emit": {
      "event": "text",
      "fields": {
        "text": {
          "path": "text"
        },
        "delta": {
          "value": true
        }
      }
    }
  },
  {
    "name": "shell-started",
    "when": [
      {
        "op": "eq",
        "path": "type",
        "value": "tool_call"
      },
      {
        "op": "eq",
        "path": "subtype",
        "value": "started"
      },
      {
        "op": "exists",
        "path": "tool_call.shellToolCall"
      }
    ],
    "emit": {
      "event": "tool_call",
      "fields": {
        "id": {
          "path": "call_id"
        },
        "name": {
          "value": "shell"
        },
        "input": {
          "path": "tool_call.shellToolCall.args",
          "default": {}
        }
      }
    }
  },
  {
    "name": "shell-completed",
    "when": [
      {
        "op": "eq",
        "path": "type",
        "value": "tool_call"
      },
      {
        "op": "eq",
        "path": "subtype",
        "value": "completed"
      },
      {
        "op": "exists",
        "path": "tool_call.shellToolCall"
      }
    ],
    "emit": {
      "event": "tool_result",
      "fields": {
        "tool_use_id": {
          "path": "call_id"
        },
        "content": {
          "path": "tool_call.shellToolCall.result.success.stdout",
          "default": ""
        },
        "is_error": {
          "value": false
        }
      }
    }
  },
