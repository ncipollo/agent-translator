  },
  {
    "name": "result-success",
    "when": [
      {
        "op": "eq",
        "path": "type",
        "value": "result"
      },
      {
        "op": "eq",
        "path": "subtype",
        "value": "success"
      }
    ],
    "emit": {
      "event": "session_result",
      "fields": {
        "success": {
          "value": true
        },
        "duration_ms": {
          "path": "duration_ms"
        },
        "result": {
          "path": "result"
        }
      }
    }
  },
  {
    "name": "result-error",
    "when": [
      {
        "op": "eq",
        "path": "type",
        "value": "result"
      }
    ],
    "emit": {
      "event": "session_result",
      "fields": {
        "success": {
          "value": false
        },
        "duration_ms": {
          "path": "duration_ms"
        },
        "error": {
          "path": "result",
          "default": "error"
        }
      }
    }
  }
